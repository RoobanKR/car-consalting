# Copy to .env.local and fill in. Set the same variables in Vercel > Settings > Environment Variables.

# MongoDB
MONGODB_URI=

# Admin auth
JWT_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

# Google Drive media storage (run `npm run drive:auth` for the refresh token)
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=

# Cloudinary (used only when Google Drive is not configured)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Home page counter
PARTNER_DEALERS=15
