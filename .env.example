# Copy to .env.local and fill in. Set the same variables in Vercel > Settings > Environment Variables.

# MongoDB
MONGODB_URI=

# Admin auth
JWT_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

# Google Drive media storage (run `npm run drive:auth` for the refresh token)
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=

# Cloudinary (used only when Google Drive is not configured)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Home page counter
PARTNER_DEALERS=15

# SEO: public site address (change when you connect a custom domain) and the
# Google Search Console verification code (HTML tag method, content="..." value only)
NEXT_PUBLIC_SITE_URL=https://car-consalting.vercel.app
GOOGLE_SITE_VERIFICATION=
