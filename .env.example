# Copy to .env.local and fill in. Next loads .env.local automatically.
# None of these may be prefixed with NEXT_PUBLIC_ — they are server-side secrets.
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/dbname
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@example.com
# Generate with: node -e "console.log(require('bcryptjs').hashSync('your-password', 12))"
ADMIN_PASSWORD_HASH=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
